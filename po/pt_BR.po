#, python-brace-format
msgid "Cannot write {path}: {reason}. Choose another project folder."
msgstr "Não foi possível gravar {path}: {reason}. Escolha outra pasta de projeto."

#. G_NO_STACKUP
msgid "The board has no stackup. Choose the stackup jlcpcb-2l, or kicad-default to accept KiCad's default rule."
msgstr "A placa não tem empilhamento. Escolha o empilhamento jlcpcb-2l, ou kicad-default para aceitar a regra padrão do KiCad."

#. G_STACKUP_LAYERS
#, python-brace-format
msgid "The stackup has {stackup} copper layers but the board has {board}. Fix the board stackup in KiCad, or choose a matching stackup."
msgstr "O empilhamento tem {stackup} camadas de cobre, mas a placa tem {board}. Corrija o empilhamento da placa no KiCad, ou escolha um empilhamento compatível."

#. G_LID_HEIGHT_MISSING
#, python-brace-format
msgid "Shield {refs} covers the simulated region and no lid height was given; set lid_height_mm in Advanced before you run, or set lid to false to leave the lid out."
msgstr "A blindagem {refs} cobre a região simulada e nenhuma altura de tampa foi dada; defina lid_height_mm na aba Avançado antes de executar, ou defina lid como false para deixar a tampa de fora."

#. G_PART_NO_MODEL
#, python-brace-format
msgid "Part {ref} {value}: {role}; no package preset, so as a port a C, L or R takes its ideal value and any other part needs its S2P file, which its row in Results and retune takes."
msgstr "Componente {ref} {value}: papel \"{role}\"; sem predefinição de encapsulamento, então, como porta, um C, L ou R assume o valor ideal e qualquer outro componente precisa do arquivo S2P dele, que a linha dele na aba Resultados e ajuste recebe."

#. G_NO_REFERENCE
#, python-brace-format
msgid "No reference found for {signal}; set its port's reference (ports[].reference) in Advanced before you run."
msgstr "Nenhuma referência encontrada para {signal}; defina a referência da porta (ports[].reference) na aba Avançado antes de executar."

