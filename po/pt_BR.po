msgid "{board} as saved lacks a pad or a part selected in KiCad, which holds edits not yet saved: save the board in KiCad and press the button again."
msgstr "A versão salva de {board} não tem uma ilha ou um componente selecionado no KiCad, que guarda edições ainda não salvas: salve a placa no KiCad e pressione o botão de novo."

#. G_HANDOFF_PADS
#, python-brace-format
msgid "{count} pads are selected in KiCad. Select only the chain's two end pads and press the button again, or pick start and end here."
msgstr "Ilhas selecionadas no KiCad: {count}. Selecione só as duas ilhas das extremidades da cadeia e pressione o botão de novo, ou escolha o início e o fim aqui."

#. G_REFILL
