#~ msgstr "{path} não é um projeto de antena: `compare` compara dois projetos de antena, criados com `new --antenna`."

#~ msgid "Preset {preset} (provisional default), T_max {t_max_ns} ns, stop window {window_ns} ns, mesh n {mesh_n} with cells up to {max_cell_mm} mm between the copper edges (λ/40 at f_max, the 2D εeff {eeff}), dielectric {dielectric}, timestep floor {dt_floor}, region and protected reach {reach_h} substrate heights ({reach_mm} mm)."
