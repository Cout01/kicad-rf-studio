msgstr ""

#. I_COST_CELLS
#, python-brace-format
msgid "Cells: {nx} × {ny} × {nz} = {mcells} M (mesh n {n}, cell d {d_mm} mm)."
msgstr ""

#. I_COST_SPLIT
#, python-brace-format
msgid "Cells: {board} M in the board, {air} M of air and {pml} M of PML; the time counts a PML cell as {weight} cells and runs this model at {ratio} × the calibrated speed (gate P3-A)."
msgstr ""

#. I_COST_SMALLEST
#, python-brace-format
msgid "Smallest cell: {size_um} µm across {axis}, at {axis} = {at_mm} mm."
msgstr ""

#. I_COST_DT
#, python-brace-format
