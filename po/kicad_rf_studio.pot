#. I_COST_DRIVER_RUNS
#, python-brace-format
msgid "Main cost: {runs} runs, one per port, {parts} of them part ports."
msgstr ""

#. I_COST_DRIVER_CELLS
#, python-brace-format
msgid "Main cost: the cell count. The cell d {d_mm} mm follows the narrowest width, gap or substrate height; a smaller region.expand_h shrinks it."
msgstr ""

#. W_NO_PORTS
msgid "project.json has no ports, so cost stops after the 2D estimate. Create the project with `new` between two pads to simulate it."
